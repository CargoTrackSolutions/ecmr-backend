{
  "realm": "cargotrack",
  "displayName": "CargoTrack (dev)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self' http://localhost:*; object-src 'none';",
    "xFrameOptions": ""
  },
  "clients": [
    {
      "clientId": "ecmr-frontend",
      "name": "eCMR frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8082/*", "http://localhost:8081/api/swagger-ui/oauth2-redirect.html"],
      "webOrigins": ["http://localhost:8082", "http://localhost:8081"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8082/*"
      }
    }
  ],
  "users": [
    {
      "username": "admin@cargotrack.local",
      "email": "admin@cargotrack.local",
      "emailVerified": true,
      "firstName": "CargoTrack",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }]
    },
    {
      "username": "dispecer@cargotrack.local",
      "email": "dispecer@cargotrack.local",
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Dispecer",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "dispecer", "temporary": false }]
    }
  ]
}
