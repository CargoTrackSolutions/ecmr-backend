# Copy to /opt/ecmr/.env (chmod 600). Generate values with: openssl rand -hex 16
POSTGRES_PASSWORD=
KC_ADMIN_PASSWORD=
# Initial password of admin@cargotrack.local - also set it in keycloak/cargotrack-realm.json (CHANGE_ME) before the first start
ECMR_ADMIN_PASSWORD=
# Password of secrets/eseal.p12 (scripts/eseal-keystore.sh)
ESEAL_PASSWORD=
CARGOTRACK_SMS_ENABLED=false
CARGOTRACK_SMS_TOKEN=
CARGOTRACK_SMS_SENDER=609
CARGOTRACK_SMS_TEMPLATE=Codul dvs. eCMR: {tan}. Introduceti codul sau deschideti linkul: {link}
