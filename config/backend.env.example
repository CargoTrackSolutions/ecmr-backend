# Copy to backend.env (git-ignored) or map to your secret store / Kubernetes secrets.
# Spring relaxed binding: property a.b-c -> env A_B_C.

# Profiles: "cargotrack" always; add "jobs" on exactly one instance (import/sync/archive/delete jobs).
SPRING_PROFILES_ACTIVE=cargotrack,jobs

# Public URLs
APP_ORIGIN_URL=https://ecmr-api.example.cargotrack.ro
APP_FRONTEND_URL=https://ecmr.example.cargotrack.ro
WEB_CORS_ORIGINS=https://ecmr.example.cargotrack.ro

# Database (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/ecmr
SPRING_DATASOURCE_USERNAME=ecmr
SPRING_DATASOURCE_PASSWORD=change-me

# First admin (must match the e-mail claim from the identity provider)
SPRING_LIQUIBASE_PARAMETERS_BOOTSTRAPADMINEMAIL=admin@cargotrack.ro

# Identity provider (OIDC issuer; must be reachable at startup)
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUERURI=https://login.example.cargotrack.ro/realms/cargotrack

# SMTP
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=no-reply@cargotrack.ro

# eSeal signing identity (mount the keystore read-only; never use the upstream test keystore in production)
ECMR_SEAL_SIGN_KEYSTORETYPE=PKCS12
ECMR_SEAL_SIGN_KEYSTOREPATH=/secrets/eseal.p12
ECMR_SEAL_SIGN_KEYSTOREPASSWORD=change-me
ECMR_SEAL_SIGN_KEYALIAS=cargotrack-ecmr
ECMR_SEAL_SIGN_KEYPASSWORD=change-me

# Guest TAN SMS via SMSO (https://app.smso.ro). Disabled: the TAN message is only written to the log.
CARGOTRACK_SMS_ENABLED=false
CARGOTRACK_SMS_TOKEN=smso-api-key
CARGOTRACK_SMS_SENDER=609
# CARGOTRACK_SMS_URL=https://app.smso.ro/api/v1/send
# Optional, replaces upstream's English text ({tan}, {link}); without diacritics it stays a single 160-character SMS
# CARGOTRACK_SMS_TEMPLATE=Codul dvs. eCMR: {tan}. Introduceti codul sau deschideti linkul: {link}
