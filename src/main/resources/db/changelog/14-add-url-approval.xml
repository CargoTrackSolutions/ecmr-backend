<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd" objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1761223074815-1" author="thomas.dukvin">
        <createTable tableName="approved_url">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_approved_url"/>
            </column>
            <column name="url" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="approved_state" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="creation_timestamp" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="update_timestamp" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="last_update_user_id" type="BIGINT"/>
        </createTable>
        <createTable tableName="ecmr_import">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_ecmr_import"/>
            </column>
            <column name="instance_url" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="ecmr_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="sharing_user_email" type="VARCHAR(255)"/>
            <column name="receiving_user_email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="share_token" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="seal" type="CLOB"/>
            <column name="error_message" type="VARCHAR(255)"/>
            <column name="creation_timestamp" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <dropColumn tableName="mail_suffix" columnName="url"/>

        <addColumn tableName="mail_suffix">
            <column name="approved_url_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint baseTableName="approved_url" baseColumnNames="last_update_user_id" constraintName="fk_approved_url_ecmr_user"
                                 referencedTableName="ecmr_user"
                                 referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="mail_suffix" baseColumnNames="approved_url_id" constraintName="fk_mail_suffix_approved_url"
                                 referencedTableName="approved_url"
                                 referencedColumnNames="id"/>

    </changeSet>
</databaseChangeLog>
