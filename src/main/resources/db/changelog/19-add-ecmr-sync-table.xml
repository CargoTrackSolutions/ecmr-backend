<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd" objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1765354287129-19" author="thomas.dukvin">
        <createTable tableName="ecmr_sync">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_ecmr_sync"/>
            </column>
            <column name="ecmr_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="VARCHAR(255)"/>
            <column name="creation_timestamp" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="next_retry_timestamp" type="DATETIME"/>
            <column name="retry_count" type="INT"/>
        </createTable>
    </changeSet>
</databaseChangeLog>